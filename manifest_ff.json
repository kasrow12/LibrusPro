{
	"name": "Librus Ultra – rozszerzenie do Librusa",
	"version": "4.0.2",
	"description": "Librus Ultra – ulepszenia dla Librusa: ciemny motyw, średnie, frekwencja i własny terminarz.",
	"manifest_version": 2,
	"author": "RUTUJEK",
	"short_name": "Librus Ultra",
	"permissions": [ "storage", "https://synergia.librus.pl/*", "https://portal.librus.pl/*" ],
	"icons": {
		"512": "img/icon.png"
	},
	"browser_action": {
		"default_icon": "img/icon.png",
		"default_popup": "popup.html"
	},
	"background": {
		"scripts": [ "background.js" ],
		"persistent": false
	},
	"content_scripts": [
		{
			"matches": [ "https://synergia.librus.pl/*" ],
			"js": [ "librusUltra.js" ],
			"all_frames": true
		},
		{
			"matches": [ "https://synergia.librus.pl/*" ],
			"css": [ "librusUltra.css" ],
			"run_at": "document_start"
		},
		{
			"matches": [ "https://portal.librus.pl/*" ],
			"js": [ "portal.js" ]
		}
	],
	"web_accessible_resources": [ "img/*" ],
	"browser_specific_settings": {
		"gecko": {
			"id": "{2ddaa55f-7db8-460a-bf9b-01396684935b}"
		}
	}
}
